{
  "load_direnv": "direct",
  "languages": {
    "C": {
      "enable_language_server": true,
      "format_on_save": "on",
      "tab_size": 4,
      "semantic_tokens": "combined",
      "document_symbols": "on"
    },
    "C++": {
      "enable_language_server": true,
      "format_on_save": "on",
      "tab_size": 4,
      "semantic_tokens": "combined",
      "document_symbols": "on"
    }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": [
          "--background-index",
          "--compile-commands-dir=build",
          "--query-driver=/usr/bin/c++,/usr/bin/g++",
          "--header-insertion=never"
        ]
      }
    }
  }
}
